/**
    Orrery - a polymetric step sequencer.

    Eight voices, each with eight lanes: trigger, hold, rate, nudge, ratchet, gate, pitch and
    velocity. Every slot is one 16th, and a slot either starts a note, extends the note before it,
    or is silent:

        trigger >= (1 - density)              -> start a note
        hold >= (1 - holdAmount), sounding    -> extend that note
        otherwise                             -> rest

    Density and Hold are thresholds internally, but they are exposed the way round a player
    expects: turning them up gives more notes and longer notes.

    Step length is therefore emergent rather than stored, and gate is a percentage of whatever
    length the holds produced. Because the decision is a threshold rather than a coin toss, the
    pattern is stable - the editor can draw exactly what will play.

    Each lane cycles through a window of its own value array, so a lane of length 5 inside a
    16-slot pattern phases against one of length 16. A lane can walk that window forwards,
    backwards or as a pendulum, which changes its effective period without redrawing anything.

    Trigger, hold, rate and nudge decide the rhythm and are read at every slot. Ratchet, pitch,
    velocity and gate describe a note and advance once per note, so a five-note pitch lane keeps
    its order however the rhythm falls, and no value is skipped when the density changes.

    Rate is how often a step comes round, counted in passes rather than thrown as dice: a half
    plays every other pass, a third every third, spread as evenly as the fraction allows. It only
    silences a note - the note keeps its slot, its span and its turn at the per-note lanes - so
    what the rest of the pattern plays never depends on which passes this one takes. The pass is
    counted from the transport position, so the same bar always sounds the same way.

    Ratchet divides a note's length rather than adding to it: the strikes share the space one note
    would have taken instead of running past it, so a pattern keeps its shape however hard it is
    struck. The strikes still owed are held on the voice rather than in the pass that placed them -
    they outlive the slot data they came from, and the next note cuts them short exactly as a
    monophonic voice cuts anything it interrupts.

    Nudge takes a note off the grid by up to half a 16th either way, so a slot is a moment in time
    rather than an edge to be crossed. Half a step is the limit because at exactly half a note can
    reach its neighbour's moment but never overtake it - so one pointer walking the pass in order
    is all the scheduling a voice needs, and a pass is resolved half a step before it begins.

    The step data arrives as events rather than parameters - there are far too many values to
    expose as automatable endpoints. The view owns that data and replays it on load.

    Always host-synced: there is no internal clock.
*/

processor Orrery [[ main ]]
{
    //==============================================================================
    input event std::timeline::Tempo          tempoIn;
    input event std::timeline::Position       positionIn;
    input event std::timeline::TransportState transportIn;

    output event std::midi::Message midiOut;

    /// The slot each voice has just entered, so the editor can follow along.
    output event Playhead playheadOut;

    //==============================================================================
    /**
        The only automatable parameter, and the editor never writes to it. A scene holds a whole
        board - every voice with its lanes and its settings - so the host arranges by switching
        scenes rather than by automating forty knobs, and nothing else can be fighting a scene
        for ownership of a value.
    */
    input event int32 sceneIn [[ name: "Scene", min: 1, max: 8, init: 1, step: 1 ]];

    /**
        Lets the editor hear the scene it is working on without touching the parameter the host
        owns. A listening aid like the solo mask, not a second way to arrange: zero hands playback
        straight back to whatever the host last asked for.
    */
    input event int32 auditionSceneIn;

    input event LaneValues    laneValuesIn;
    input event LaneSettings  laneSettingsIn;
    input event StepEdit      stepEditIn;
    input event VoiceSettings voiceSettingsIn;

    /// A listening aid the editor applies over the scene, not part of any scene. Zero means none.
    input event int32 soloMaskIn;

    //==============================================================================
    struct LaneValues
    {
        int32 scene;
        int32 voice;
        int32 lane;
        float32[64] values;
    }

    struct LaneSettings
    {
        int32 scene;
        int32 voice;
        int32 lane;
        int32 start;
        int32 length;
        int32 offset;
        int32 direction;
        float32 low;
        float32 high;
    }

    struct StepEdit
    {
        int32 scene;
        int32 voice;
        int32 lane;
        int32 index;
        float32 value;
    }

    /// What used to arrive as per-voice parameters, now addressed to the scene that owns it.
    struct VoiceSettings
    {
        int32 scene;
        int32 voice;
        int32 on;
        int32 steps;
        float32 density;
        float32 hold;
        int32 cycle;
        int32 phase;
    }

    struct Playhead
    {
        int32 voice;
        int32 slot;
        /// Where the pass the slot belongs to began, so the editor can read the lanes at the
        /// same place the patch is reading them rather than always at the first pass.
        int32 position;
        int32 noteIndex;
    }

    //==============================================================================
    let voiceCount = 8;
    let laneCount  = 8;
    let maxSteps   = 64;
    let sceneCount = 8;

    let directionForward  = 0;
    let directionReverse  = 1;
    let directionPendulum = 2;

    let laneTrigger  = 0;
    let laneHold     = 1;
    let laneRate     = 2;
    let laneNudge    = 3;
    let laneRatchet  = 4;
    let laneGate     = 5;
    let lanePitch    = 6;
    let laneVelocity = 7;

    /// Half a step either way. At exactly half, a note pushed late can reach the moment of the
    /// one after it but never overtake it, so a pass always sounds in the order it was drawn.
    let maxNudgeSteps = 0.5;

    let maxRatchetHits = 8;

    /// Every scene holds a full board, so the stores are scene-major and only one is ever played.
    let totalLanes   = sceneCount * voiceCount * laneCount;
    let totalValues  = totalLanes * maxSteps;
    let totalVoices  = sceneCount * voiceCount;
    let totalSlots   = voiceCount * maxSteps;

    float32[totalValues] stepValues;        // normalised 0..1 positions
    int32[totalLanes]    windowStart;
    int32[totalLanes]    windowLength;
    /// Where inside the window a lane begins reading, so lanes can share values out of phase.
    int32[totalLanes]    windowOffset;
    /// Which way the lane walks away from that point.
    int32[totalLanes]    windowDirection;
    float32[totalLanes]  outputLow;
    float32[totalLanes]  outputHigh;

    bool[totalSlots]    slotIsTrigger;
    int32[totalSlots]   slotPitch;
    int32[totalSlots]   slotVelocity;
    int32[totalSlots]   slotSpan;
    float32[totalSlots] slotGate;
    /// How far off its slot a note sounds, in 16ths. Zero everywhere a note does not start.
    float64[totalSlots] slotNudge;
    /// How many times a note is struck inside its own length. One everywhere else.
    int32[totalSlots]   slotRatchet;
    /// Whether the note starting here is one of the passes it takes. Structure is decided once;
    /// this is the only thing about a slot that answers differently from one pass to the next.
    bool[totalSlots]    slotSounds;

    /// Only a free-running voice carries this: a realigning one counts back instead.
    int32[voiceCount]   passNoteStart;
    int32[voiceCount]   passTriggerCount;

    /// What the pass now in the slot arrays was resolved from, kept so the editor can be told
    /// where the lanes are rather than assuming the pattern's first pass.
    int32[voiceCount]   passOriginPosition;
    int32[voiceCount]   passOriginNote;

    bool[voiceCount]    voiceEnabled;
    bool[voiceCount]    notePlaying;
    int32[voiceCount]   playingNote;
    float64[voiceCount] noteOffAt;

    /**
        A ratchet belongs to the note that is sounding rather than to the pass that placed it, so
        the strikes still to come are held on the voice. That way they outlive the slot data they
        came from, and the next note simply cuts them short - which is what a monophonic voice
        does to anything it interrupts.
    */
    int32[voiceCount]   strikesLeft;
    float64[voiceCount] strikeInterval;
    float64[voiceCount] strikeNextAt;
    int32[voiceCount]   strikeNote;
    int32[voiceCount]   strikeVelocity;
    float64[voiceCount] strikeGate;

    /**
        The settings of the scene being played, mirrored out of the per-scene stores below. Keeping
        a live copy means the sequencing code never has to know that scenes exist at all - only
        loadScene and the settings event write here.
    */
    int32[voiceCount]   voicePatternLength;
    float32[voiceCount] voiceTriggerThreshold;
    float32[voiceCount] voiceHoldThreshold;
    /// Steps between realignments of every lane, or zero to let them free-run.
    int32[voiceCount]   voiceResetCycle;
    /// Added to every lane's own offset, so one control turns the whole voice at once.
    int32[voiceCount]   voicePhase;
    bool[voiceCount]    voiceNeedsRebuild;

    bool[totalVoices]    sceneVoiceOn;
    int32[totalVoices]   sceneVoiceSteps;
    float32[totalVoices] sceneTriggerThreshold;
    float32[totalVoices] sceneHoldThreshold;
    int32[totalVoices]   sceneResetCycle;
    int32[totalVoices]   scenePhase;

    int32 currentScene;

    /// The host's standing choice, held apart from what is sounding so that auditioning a scene
    /// can hand playback back to it rather than overwriting it.
    int32 parameterScene;

    /// The scene the editor is listening to, counted from one. Zero means it is not listening.
    int32 auditionScene;

    /// Bit per voice, set by the editor. Zero means nothing is soloed and the scene decides.
    int32 soloMask;

    int64[voiceCount]   voiceCurrentPass;
    /// Where the playhead is, which is the slot the voice is metrically in rather than the note
    /// it last sounded - nudged notes come off the grid, the playhead does not.
    int32[voiceCount]   voiceCurrentSlot;

    /// Position of the current pass's first slot, so a slot's moment is a time rather than an
    /// edge to be crossed.
    float64[voiceCount] voicePassStart;

    /// The next slot of the pass owed a hearing. Everything before it has already had its moment.
    int32[voiceCount]   voiceNextSlot;

    float64 pos16;

    bool needsRelocate = true;
    bool hostPlaying, transportSeen;
    int32 hostTimeout;
    float32 hostBpm = 120.0f;

    //==============================================================================
    /// The host counts scenes from one, everything inside here counts from zero.
    event sceneIn (int32 value)
    {
        parameterScene = clamp (value, 1, sceneCount) - 1;
        applySceneChoice();
    }

    event auditionSceneIn (int32 value)
    {
        auditionScene = clamp (value, 0, sceneCount);
        applySceneChoice();
    }

    event soloMaskIn (int32 mask)
    {
        soloMask = mask;
        refreshAudibility();
    }

    event voiceSettingsIn (VoiceSettings update)
    {
        if (! isSceneValid (update.scene) || ! isVoiceValid (update.voice))
            return;

        let s = wrap<totalVoices> (voiceSlot (update.scene, update.voice));

        sceneVoiceOn[s]          = update.on != 0;
        sceneVoiceSteps[s]       = clamp (update.steps, 4, maxSteps);
        sceneTriggerThreshold[s] = 1.0f - update.density;
        sceneHoldThreshold[s]    = 1.0f - update.hold;
        sceneResetCycle[s]       = clamp (update.cycle, 0, maxSteps);
        scenePhase[s]            = clamp (update.phase, 0, maxSteps - 1);

        // Editing the scene that is playing has to reach the live copy the sequencer reads.
        if (update.scene == currentScene)
            mirrorVoice (update.voice);
    }

    event laneValuesIn (LaneValues update)
    {
        if (! isLaneValid (update.scene, update.voice, update.lane))
            return;

        let base = laneBase (update.scene, update.voice, update.lane);

        for (int32 i = 0; i < maxSteps; ++i)
            stepValues[wrap<totalValues> (base + i)] = update.values[wrap<maxSteps> (i)];

        markRebuild (update.scene, update.voice);
    }

    event laneSettingsIn (LaneSettings update)
    {
        if (! isLaneValid (update.scene, update.voice, update.lane))
            return;

        let lane = wrap<totalLanes> (laneIndex (update.scene, update.voice, update.lane));

        windowLength[lane]    = clamp (update.length, 1, maxSteps);
        windowStart[lane]     = clamp (update.start, 0, maxSteps - windowLength[lane]);
        windowOffset[lane]    = clamp (update.offset, 0, windowLength[lane] - 1);
        windowDirection[lane] = clamp (update.direction, directionForward, directionPendulum);
        outputLow[lane]       = update.low;
        outputHigh[lane]      = update.high;

        markRebuild (update.scene, update.voice);
    }

    event stepEditIn (StepEdit edit)
    {
        if (! isLaneValid (edit.scene, edit.voice, edit.lane) || edit.index < 0 || edit.index >= maxSteps)
            return;

        let base = laneBase (edit.scene, edit.voice, edit.lane);
        stepValues[wrap<totalValues> (base + edit.index)] = edit.value;

        markRebuild (edit.scene, edit.voice);
    }

    //==============================================================================
    event tempoIn (std::timeline::Tempo t)
    {
        if (t.bpm > 1.0f)
            hostBpm = t.bpm;

        markHostAlive();
    }

    event transportIn (std::timeline::TransportState t)
    {
        transportSeen = true;
        hostPlaying = t.isPlaying();
        markHostAlive();

        if (! hostPlaying)
        {
            allNotesOff();
            needsRelocate = true;
        }
    }

    event positionIn (std::timeline::Position p)
    {
        markHostAlive();

        let newPos = p.quarterNote * 4.0;

        if (abs (newPos - pos16) > 0.25)
            needsRelocate = true;

        pos16 = newPos;
    }

    //==============================================================================
    bool isSceneValid (int32 scene) { return scene >= 0 && scene < sceneCount; }
    bool isVoiceValid (int32 voice) { return voice >= 0 && voice < voiceCount; }

    bool isLaneValid (int32 scene, int32 voice, int32 lane)
    {
        return isSceneValid (scene) && isVoiceValid (voice) && lane >= 0 && lane < laneCount;
    }

    int32 voiceSlot (int32 scene, int32 voice)
    {
        return scene * voiceCount + voice;
    }

    int32 laneIndex (int32 scene, int32 voice, int32 lane)
    {
        return voiceSlot (scene, voice) * laneCount + lane;
    }

    int32 laneBase (int32 scene, int32 voice, int32 lane)
    {
        return laneIndex (scene, voice, lane) * maxSteps;
    }

    /// Only the scene being played has anything to rebuild; the others are rebuilt when loaded.
    void markRebuild (int32 scene, int32 voice)
    {
        if (scene == currentScene)
            voiceNeedsRebuild[wrap<voiceCount> (voice)] = true;
    }

    bool audibleInCurrentScene (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        if (soloMask != 0)
            return (soloMask & (1 << v)) != 0;

        return sceneVoiceOn[wrap<totalVoices> (voiceSlot (currentScene, voice))];
    }

    /// Copies one voice out of the playing scene into the live arrays the sequencer reads.
    void mirrorVoice (int32 voice)
    {
        let v = wrap<voiceCount> (voice);
        let s = wrap<totalVoices> (voiceSlot (currentScene, voice));

        voicePatternLength[v]    = sceneVoiceSteps[s];
        voiceTriggerThreshold[v] = sceneTriggerThreshold[s];
        voiceHoldThreshold[v]    = sceneHoldThreshold[s];
        voiceResetCycle[v]       = sceneResetCycle[s];
        voicePhase[v]            = scenePhase[s];
        voiceEnabled[v]          = audibleInCurrentScene (voice);
        voiceNeedsRebuild[v]     = true;

        if (! voiceEnabled[v])
            sendNoteOff (voice);
    }

    void refreshAudibility()
    {
        for (int32 voice = 0; voice < voiceCount; ++voice)
        {
            let v = wrap<voiceCount> (voice);
            voiceEnabled[v] = audibleInCurrentScene (voice);

            if (! voiceEnabled[v])
                sendNoteOff (voice);
        }
    }

    /// The editor's audition wins while it lasts, and the parameter is waiting underneath it.
    void applySceneChoice()
    {
        loadScene (auditionScene > 0 ? auditionScene - 1 : parameterScene);
    }

    /**
        Switching scene swaps the whole board. Pass positions are deliberately left alone, so a
        scene change lands wherever the music already is rather than restarting every voice.
    */
    void loadScene (int32 scene)
    {
        if (! isSceneValid (scene))
            return;

        currentScene = scene;

        for (int32 voice = 0; voice < voiceCount; ++voice)
            mirrorVoice (voice);
    }

    void markHostAlive() { hostTimeout = int32 (processor.frequency * 0.25); }
    bool hostAlive()     { return hostTimeout > 0; }
    bool isRunning()     { return transportSeen ? hostPlaying : hostAlive(); }

    float64 framesPer16th() { return (15.0 / float64 (max (hostBpm, 1.0f))) * processor.frequency; }

    /// Read indices only ever grow, but reverse subtracts from them, so the wrap has to survive
    /// a negative.
    int32 wrapWithin (int32 value, int32 length)
    {
        return ((value % length) + length) % length;
    }

    /**
        Where inside its window the lane has travelled to. Forward and reverse walk away from the
        phase in either direction; pendulum folds the same count back on itself, so it turns at
        the window's edges instead of jumping back to the start.

        The voice's phase adds to the lane's own offset before the window wraps, so each lane turns
        through its own length and a direction reads it as it reads any other offset.
    */
    int32 windowPosition (int32 lane, int32 readIndex, int32 phase)
    {
        let here = wrap<totalLanes> (lane);
        let length = windowLength[here];

        // Also covers a lane the editor has not described yet, whose length is still zero.
        if (length < 2)
            return 0;

        let offset = windowOffset[here] + phase;
        let direction = windowDirection[here];

        if (direction == directionReverse)
            return wrapWithin (offset - readIndex, length);

        if (direction == directionPendulum)
        {
            let span = length * 2 - 2;
            let bounce = wrapWithin (offset + readIndex, span);

            return bounce < length ? bounce : span - bounce;
        }

        return wrapWithin (offset + readIndex, length);
    }

    /**
        Mirrors the editor: a lane cycles through the window its start and length describe, and
        the stored position is mapped onto the output range only at the point of use - so moving
        the range while the sequence runs rescales it instead of overwriting anything.
    */
    float32 laneOutput (int32 voice, int32 lane, int32 readIndex)
    {
        let which = laneIndex (currentScene, voice, lane);
        let here = wrap<totalLanes> (which);
        let index = windowStart[here] + windowPosition (which, readIndex,
                                                        voicePhase[wrap<voiceCount> (voice)]);
        let base = laneBase (currentScene, voice, lane);
        let normalised = stepValues[wrap<totalValues> (base + index)];

        return outputLow[here] + normalised * (outputHigh[here] - outputLow[here]);
    }

    //==============================================================================
    /**
        Whether a step drawn at this rate takes this pass. Not a coin toss: the passes a step takes
        are spread as evenly as its fraction allows, so a half plays every other pass and a third
        every third one - another wheel turning at its own ratio rather than a die being thrown.

        The pass is counted from the transport position, so the same bar always sounds the same way
        however the host arrived at it.
    */
    bool ratePermits (float64 rate, int64 pass)
    {
        if (rate >= 1.0)  return true;
        if (rate <= 0.0)  return false;

        let turned = float64 (pass);

        return floor ((turned + 1.0) * rate) > floor (turned * rate);
    }

    /**
        How far into its reset cycle a pass begins. Worked out from the pass number rather than
        carried across the boundary, because a cycle may be longer than the pass and so has to
        remember which turn it is on - which means a transport jump lands in the same phase the
        music would have reached playing through.
    */
    int32 passStartPosition (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        // Never located, or located before the timeline's zero: the pattern starts where it starts.
        let pass = voiceCurrentPass[v] < 0 ? int64 (0) : voiceCurrentPass[v];
        let stepped = pass * int64 (voicePatternLength[v]);
        let cycle = voiceResetCycle[v];

        return int32 (cycle > 0 ? stepped % int64 (cycle) : stepped);
    }

    /**
        The note count a pass starts from. The per-note lanes advance by notes rather than steps,
        so no arithmetic answers this - but the trigger lane already holds what it takes to count
        them, and at most one cycle of them, which keeps this cheap enough to do on every pass.
    */
    int32 notesSinceRealignment (int32 voice, int32 startPosition)
    {
        let v = wrap<voiceCount> (voice);

        int32 notes = 0;

        for (int32 position = 0; position < startPosition; ++position)
            if (laneOutput (voice, laneTrigger, position) >= voiceTriggerThreshold[v])
                ++notes;

        return notes;
    }

    /**
        Resolves one pass of a voice's pattern. A hold can only be recognised after the note it
        extends has already been placed, so each hold reaches back and lengthens the trigger
        that owns it.
    */
    void buildVoice (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        // Zero means the lanes never realign and each free-runs at its own length.
        let cycle = voiceResetCycle[v];
        let startPosition = passStartPosition (voice);

        // Worked out rather than remembered, so a rebuild mid-edit and a jump both answer the
        // same as playing into the pass would have.
        int32 noteIndex = cycle > 0 ? notesSinceRealignment (voice, startPosition)
                                    : passNoteStart[v];

        passOriginPosition[v] = startPosition;
        passOriginNote[v]     = noteIndex;

        int32 triggerSlot = -1;
        int32 triggers = 0;

        for (int32 slot = 0; slot < voicePatternLength[v]; ++slot)
        {
            let here = wrap<totalSlots> (voice * maxSteps + slot);

            int32 position = startPosition + slot;

            if (cycle > 0)
            {
                position = position % cycle;

                if (position == 0)
                    noteIndex = 0;
            }

            slotIsTrigger[here] = false;
            slotSounds[here]    = false;
            slotNudge[here]     = 0;
            slotRatchet[here]   = 1;

            if (laneOutput (voice, laneTrigger, position) >= voiceTriggerThreshold[v])
            {
                slotIsTrigger[here] = true;
                slotPitch[here]     = clamp (int32 (laneOutput (voice, lanePitch, noteIndex)), 0, 127);
                slotVelocity[here]  = clamp (int32 (laneOutput (voice, laneVelocity, noteIndex)), 1, 127);
                slotGate[here]      = laneOutput (voice, laneGate, noteIndex);
                slotSpan[here]      = 1;

                // Drawn as a percentage of a 16th, and read at the slot rather than per note, so
                // a short nudge lane is a groove the rhythm falls through.
                slotNudge[here] = clamp (float64 (laneOutput (voice, laneNudge, position)) * 0.01,
                                         -maxNudgeSteps, maxNudgeSteps);

                // Read per note, like gate and velocity, because it describes a note rather than
                // the rhythm the note landed in.
                slotRatchet[here] = clamp (int32 (laneOutput (voice, laneRatchet, noteIndex)),
                                           1, maxRatchetHits);

                // Rate silences a note without unplacing it: the note keeps its slot, its span and
                // its turn at the per-note lanes, so what the rest of the pattern plays does not
                // depend on which passes this one takes.
                slotSounds[here] = ratePermits (float64 (laneOutput (voice, laneRate, position)) * 0.01,
                                                voiceCurrentPass[v]);

                triggerSlot = slot;
                ++noteIndex;
                ++triggers;
            }
            else if (triggerSlot >= 0 && laneOutput (voice, laneHold, position) >= voiceHoldThreshold[v])
            {
                ++slotSpan[wrap<totalSlots> (voice * maxSteps + triggerSlot)];
            }
            else
            {
                triggerSlot = -1;
            }
        }

        passTriggerCount[v] = triggers;
        voiceNeedsRebuild[v] = false;
    }

    /**
        Carried over the pass boundary before the next pass is resolved, because where the lanes
        have got to is what the resolving reads. Only a free-running voice has anything to carry,
        so a realigning one holds nothing that a jump or an edit could leave stale.
    */
    void advancePassCounters (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        if (voiceResetCycle[v] == 0)
            passNoteStart[v] += passTriggerCount[v];
    }

    //==============================================================================
    void sendNoteOff (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        if (notePlaying[v])
        {
            midiOut <- std::midi::createMessage (0x80 + voice, playingNote[v], 0);
            notePlaying[v] = false;
        }
    }

    /// A note-off ends what is sounding; this ends what was still going to sound.
    void cancelStrikes (int32 voice)
    {
        strikesLeft[wrap<voiceCount> (voice)] = 0;
    }

    void allNotesOff()
    {
        for (int32 voice = 0; voice < voiceCount; ++voice)
        {
            cancelStrikes (voice);
            sendNoteOff (voice);
        }
    }

    /// One strike of a note. A plain note is the same thing with nothing left to follow it.
    void strike (int32 voice, int32 note, int32 velocity, float64 at, float64 length)
    {
        let v = wrap<voiceCount> (voice);

        // Monophonic per voice, so a long gate ties into the next note rather than stacking.
        sendNoteOff (voice);

        playingNote[v] = note;
        midiOut <- std::midi::createMessage (0x90 + voice, note, velocity);
        notePlaying[v] = true;
        noteOffAt[v] = at + length;
    }

    /// The strikes a ratchet still owes, laid inside the note's own length so that a roll never
    /// spills into the note after it.
    void soundDueStrikes (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        if (! voiceEnabled[v])
            cancelStrikes (voice);

        while (strikesLeft[v] > 0 && strikeNextAt[v] <= pos16)
        {
            strike (voice, strikeNote[v], strikeVelocity[v], strikeNextAt[v],
                    strikeInterval[v] * strikeGate[v]);

            strikeNextAt[v] += strikeInterval[v];
            --strikesLeft[v];
        }
    }

    /// When a slot's note is due, which is its place in the pass plus wherever the nudge lane
    /// has pushed it.
    float64 onsetOf (int32 voice, int32 slot)
    {
        let v = wrap<voiceCount> (voice);
        let here = wrap<totalSlots> (voice * maxSteps + slot);

        return voicePassStart[v] + float64 (slot) + slotNudge[here];
    }

    /**
        The onset is taken as an argument rather than read from pos16, so a note's length is
        measured from the moment it was due rather than from the frame that happened to notice.

        A ratchet divides that length rather than adding to it: the note is struck as many times as
        the lane asks for, sharing the space one strike would have taken.
    */
    void enterSlot (int32 voice, int32 slot, float64 onset)
    {
        let v = wrap<voiceCount> (voice);
        let here = wrap<totalSlots> (voice * maxSteps + slot);

        // A note the rate lane has left out of this pass is passed over rather than cut short:
        // whatever is still sounding carries on, exactly as a rest would let it.
        if (! voiceEnabled[v] || ! slotIsTrigger[here] || ! slotSounds[here])
            return;

        let hits = max (slotRatchet[here], 1);
        let interval = float64 (slotSpan[here]) / float64 (hits);
        let gateFraction = float64 (clamp (slotGate[here], 1.0f, 100.0f)) * 0.01;

        // Whatever the last note still had to say is cut off by this one starting.
        strikesLeft[v]    = hits - 1;
        strikeInterval[v] = interval;
        strikeNextAt[v]   = onset + interval;
        strikeNote[v]     = slotPitch[here];
        strikeVelocity[v] = slotVelocity[here];
        strikeGate[v]     = gateFraction;

        strike (voice, slotPitch[here], slotVelocity[here], onset, interval * gateFraction);
    }

    /// Every slot whose moment has arrived, in the order they were drawn. A rest costs a step of
    /// the walk and nothing else, which keeps one pointer standing in for the whole pass.
    void soundDueSlots (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        while (voiceNextSlot[v] < voicePatternLength[v])
        {
            let onset = onsetOf (voice, voiceNextSlot[v]);

            if (onset > pos16)
                break;

            enterSlot (voice, voiceNextSlot[v], onset);
            ++voiceNextSlot[v];
        }
    }

    /// Only the first voice of each scene starts enabled - eight at once is unusable as an
    /// opening position, and the editor overwrites all of this as soon as it connects.
    void initialiseVoices()
    {
        for (int32 scene = 0; scene < sceneCount; ++scene)
        {
            for (int32 voice = 0; voice < voiceCount; ++voice)
            {
                let s = wrap<totalVoices> (voiceSlot (scene, voice));

                sceneVoiceOn[s]          = voice == 0;
                sceneVoiceSteps[s]       = 16;
                sceneTriggerThreshold[s] = 0.42f;
                sceneHoldThreshold[s]    = 0.5f;
                sceneResetCycle[s]       = 16;
                scenePhase[s]            = 0;
            }
        }

        for (int32 voice = 0; voice < voiceCount; ++voice)
        {
            let v = wrap<voiceCount> (voice);

            voiceCurrentPass[v] = -1;
            voiceCurrentSlot[v] = -1;
        }

        applySceneChoice();
    }

    //==============================================================================
    /**
        The pass a voice is resolving, which turns over half a step before the music does. A note
        nudged back off the downbeat has to be known before its pass has nominally begun, and half
        a step of lookahead is exactly the most a nudge can ask for.
    */
    int64 resolvingPassOf (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        return int64 (floor ((pos16 + maxNudgeSteps) / float64 (voicePatternLength[v])));
    }

    void openPass (int32 voice, int64 pass)
    {
        let v = wrap<voiceCount> (voice);

        voiceCurrentPass[v] = pass;
        voicePassStart[v]   = float64 (pass) * float64 (voicePatternLength[v]);
        voiceNextSlot[v]    = 0;
    }

    /**
        Puts a voice down wherever the transport has jumped to. Everything already behind us has
        had its moment and is not owed one, apart from a note we have only just landed on: starting
        on a downbeat should still play it.
    */
    void locateVoice (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        // A free-running voice has nothing to count back from, so a jump starts its per-note lanes
        // afresh rather than resuming a count belonging to wherever the transport used to be.
        passNoteStart[v] = 0;

        openPass (voice, resolvingPassOf (voice));
        voiceCurrentSlot[v] = -1;
        buildVoice (voice);

        while (voiceNextSlot[v] < voicePatternLength[v]
                && onsetOf (voice, voiceNextSlot[v]) < pos16 - 0.05)
            ++voiceNextSlot[v];
    }

    /// The playhead follows the metre rather than the notes, so it reads the pass the music is
    /// actually in rather than the one being resolved half a step ahead of it.
    void movePlayhead (int32 voice)
    {
        let v = wrap<voiceCount> (voice);
        let patternSpan = float64 (voicePatternLength[v]);
        let loopPos = pos16 - floor (pos16 / patternSpan) * patternSpan;
        let slot = clamp (int32 (floor (loopPos)), 0, voicePatternLength[v] - 1);

        if (slot != voiceCurrentSlot[v])
        {
            voiceCurrentSlot[v] = slot;
            playheadOut <- Playhead (voice, slot, passOriginPosition[v], passOriginNote[v]);
        }
    }

    /// Each voice runs its own loop over the shared timeline, so a 12-step voice and a 16-step
    /// voice drift against each other instead of being forced onto one bar length.
    void advanceVoice (int32 voice)
    {
        let v = wrap<voiceCount> (voice);

        if (needsRelocate)
        {
            locateVoice (voice);
        }
        else
        {
            // Settle what the pass still owes before it is replaced: a note nudged past the last
            // slot is due exactly as the next pass opens.
            soundDueSlots (voice);

            let pass = resolvingPassOf (voice);

            if (pass != voiceCurrentPass[v])
            {
                if (voiceCurrentPass[v] >= 0)
                    advancePassCounters (voice);

                // The pass has to be opened before it is resolved: which pass a voice has turned
                // to is what tells the rate lane whether a step takes this one.
                openPass (voice, pass);
                buildVoice (voice);
            }
            else if (voiceNeedsRebuild[v])
            {
                buildVoice (voice);
            }
        }

        // A note starting cancels the strikes the last one still owed, so the slots go first.
        soundDueSlots (voice);
        soundDueStrikes (voice);
        movePlayhead (voice);
    }

    void main()
    {
        initialiseVoices();

        loop
        {
            if (hostTimeout > 0)
                --hostTimeout;

            if (isRunning())
            {
                if (needsRelocate)
                    allNotesOff();

                for (int32 voice = 0; voice < voiceCount; ++voice)
                    advanceVoice (voice);

                needsRelocate = false;
                pos16 += 1.0 / framesPer16th();
            }
            else
            {
                for (int32 voice = 0; voice < voiceCount; ++voice)
                    if (voiceNeedsRebuild[wrap<voiceCount> (voice)])
                        buildVoice (voice);
            }

            for (int32 voice = 0; voice < voiceCount; ++voice)
                if (notePlaying[wrap<voiceCount> (voice)] && pos16 >= noteOffAt[wrap<voiceCount> (voice)])
                    sendNoteOff (voice);

            advance();
        }
    }
}

